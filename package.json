{
  "name": "tempest-in-a-teapot",
  "version": "1.0.0",
  "private": true,
  "description": "Simultaneous-turn teatime artillery. A Discord Activity.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.mts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.mts",
    "start": "node server/dist/server/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "shots": "node tools/screenshots.mjs",
    "balance": "tsx tools/balance.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "colyseus.js": "^0.16.22",
    "concurrently": "^10.0.7",
    "phaser": "^4.2.1",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
